{
  "expo": {
    "name": "Vizon Solar",
    "slug": "vizon-solar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vizonsolar",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sparkstation.vizonsolar",
      "infoPlist": {
        "NSCameraUsageDescription": "Vizon Solar needs camera access to capture rooftop photos for site survey inspections.",
        "NSPhotoLibraryUsageDescription": "Vizon Solar needs photo library access to upload electricity bills and rooftop photos."
      }
    },
    "android": {
      "package": "com.sparkstation.vizonsolar",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to upload rooftop images for site survey inspection."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "vizon-solar-mobile-app"
      }
    }
  }
}
