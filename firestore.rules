rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Sub-collection: Quotations
      match /quotations/{quotationId} {
        allow read, write: if isOwner(userId) && isValidId(quotationId);
      }

      // Sub-collection: Survey Bookings
      match /bookings/{bookingId} {
        allow read, write: if isOwner(userId) && isValidId(bookingId);
      }
    }
  }
}
